{
  "manifest_version": 3,
  "name": "作业簿 · 南科大 BB 作业同步",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "检查南科大 Blackboard 作业并送至作业簿审核。",
  "permissions": ["storage", "alarms", "offscreen", "scripting", "nativeMessaging"],
  "host_permissions": ["https://bb.sustech.edu.cn/*", "https://cas.sustech.edu.cn/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "打开 BB 作业同步" },
  "options_page": "index.html",
  "key": ""
}
