{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Local synthetic configuration only. Production config must live outside this checkout.
  "name": "homework-local-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "../dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/", "/index.html", "/manifest.webmanifest", "/api", "/api/*"] },
  "durable_objects": { "bindings": [{ "name": "SPACE", "class_name": "PersonalSpace" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PersonalSpace"] }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "homework-local-example-files" }],
  "triggers": { "crons": ["*/15 * * * *"] }
}
