{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "作业簿",
  "version": "0.5.1",
  "identifier": "app.homeworkbook.local",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "作业簿",
        "width": 1200,
        "height": 800,
        "minWidth": 980,
        "minHeight": 650,
        "center": true,
        "visible": false,
        "maximized": false,
        "fullscreen": false,
        "backgroundColor": "#f8fafc"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": ["nsis"] }
}
